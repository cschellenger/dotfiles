# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
export PS1='\u@\h:\W \$ '
export EDITOR='emacs -nw'
export GPG_TTY=$(tty)
export DEV_DIR={{ .devDir | quote }}
export GOPATH="$HOME/go"
export GOROOT=/usr/local/go
if [[ -d "$GOROOT" ]]; then
   if ! [[ "$PATH" =~ ":$GOROOT/bin" ]]; then
      PATH="$PATH:$GOROOT/bin"
   fi
fi
if [[ -d "$HOME/.opencode/bin" ]]; then
   if ! [[ "$PATH" =~ ":$HOME/.opencode/bin" ]]; then
      PATH="$PATH:$HOME/.opencode/bin"
   fi
fi
export CARGO_HOME="$HOME/.cargo"
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]; then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
if ! [[ "$PATH" =~ ":$GOPATH/bin" ]]; then
    PATH="$PATH:$GOPATH/bin"
fi
if ! [[ "$PATH" =~ ":$CARGO_HOME/bin" ]]; then
    PATH="$PATH:$CARGO_HOME/bin"
fi
export PATH

# Arch SSH agent
touch $XDG_RUNTIME_DIR/ssh-agent.env
if ! pgrep -u "$USER" ssh-agent > /dev/null; then
    ssh-agent -t 1h > "$XDG_RUNTIME_DIR/ssh-agent.env"
fi
if [ ! -f "$SSH_AUTH_SOCK" ]; then
    source "$XDG_RUNTIME_DIR/ssh-agent.env" >/dev/null
fi

if [[ "$container" == "" ]]; then
    # on the host system
    source $HOME/.bash_host
else
    source $HOME/.bash_container
fi

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

alias emacs='emacs -nw'
alias cz=chezmoi
alias rmtilde='rm *~'

function sync_py() {
    pushd $DEV_DIR/sync &> /dev/null
    uv run sync.py $@
    popd &> /dev/null
}

if [[ $- == *i* ]]; then
   ssh-add -l | grep fedora-infinite-darkport-net &> /dev/null || ssh-add ~/.ssh/id_infinite_ed25519
fi
if [ -f "$HOME/.cargo/env" ]; then
   . "$HOME/.cargo/env"
fi
